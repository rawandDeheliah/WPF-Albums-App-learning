<Page x:Class="WpfApp2.Views.ContactUsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp2.Views"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Contact Us">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <TextBlock Text="Contact Us" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       HorizontalAlignment="Center"/>
        </Border>
        
        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30">
            <StackPanel>
                <!-- Welcome Message -->
                <Border Background="White" 
                        CornerRadius="10" 
                        Padding="25" 
                        Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="Gray" 
                                          Direction="270" 
                                          ShadowDepth="3" 
                                          BlurRadius="5" 
                                          Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Welcome to Our Application!" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#2C3E50" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>
                        
                        <TextBlock TextWrapping="Wrap" 
                                   FontSize="16" 
                                   Foreground="#34495E" 
                                   TextAlignment="Center"
                                   LineHeight="24">
                            <Run Text="We're here to help you with any questions or concerns you may have. "/>
                            <LineBreak/>
                            <Run Text="Feel free to reach out to us through any of the contact methods below."/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                
                <!-- Contact Information -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Contact Details -->
                    <Border Grid.Column="0" 
                            Background="White" 
                            CornerRadius="10" 
                            Padding="25" 
                            Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect Color="Gray" 
                                              Direction="270" 
                                              ShadowDepth="2" 
                                              BlurRadius="4" 
                                              Opacity="0.2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Get in Touch" 
                                       FontSize="20" 
                                       FontWeight="Bold" 
                                       Foreground="#2C3E50" 
                                       Margin="0,0,0,20"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="📧" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Email: support@ourapp.com" 
                                           FontSize="14" 
                                           Foreground="#34495E"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="📞" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Phone: +1 (555) 123-4567" 
                                           FontSize="14" 
                                           Foreground="#34495E"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="📍" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Address: 123 Main St, City, State" 
                                           FontSize="14" 
                                           Foreground="#34495E"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🕒" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Hours: Mon-Fri 9AM-6PM" 
                                           FontSize="14" 
                                           Foreground="#34495E"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Additional Info -->
                    <Border Grid.Column="1" 
                            Background="White" 
                            CornerRadius="10" 
                            Padding="25" 
                            Margin="10,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="Gray" 
                                              Direction="270" 
                                              ShadowDepth="2" 
                                              BlurRadius="4" 
                                              Opacity="0.2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Quick Response" 
                                       FontSize="20" 
                                       FontWeight="Bold" 
                                       Foreground="#2C3E50" 
                                       Margin="0,0,0,20"/>
                            
                            <TextBlock TextWrapping="Wrap" 
                                       FontSize="14" 
                                       Foreground="#34495E" 
                                       LineHeight="20"
                                       Margin="0,0,0,15">
                                We typically respond to all inquiries within 24 hours during business days.
                            </TextBlock>
                            
                            <TextBlock Text="💬" FontSize="18" Margin="0,10,0,5"/>
                            <TextBlock Text="Live Chat Available" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="#27AE60"/>
                            
                            <TextBlock Text="📱" FontSize="18" Margin="0,10,0,5"/>
                            <TextBlock Text="Mobile App Support" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="#3498DB"/>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- Footer Message -->
                <Border Background="#ECF0F1" 
                        CornerRadius="10" 
                        Padding="20" 
                        Margin="0,20,0,0">
                    <TextBlock Text="Thank you for choosing our application! We appreciate your business and look forward to serving you." 
                               FontSize="16" 
                               Foreground="#2C3E50" 
                               TextAlignment="Center"
                               FontStyle="Italic"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer -->
        <Border Grid.Row="2" Background="#34495E" Padding="15">
            <TextBlock Text="© 2024 Our Application. All rights reserved." 
                       FontSize="12" 
                       Foreground="White" 
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Page>
